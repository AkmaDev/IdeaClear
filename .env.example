# Clé API Claude (Anthropic) — ne jamais commiter la vraie valeur.
# Obtenir une clé : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Domaine autorisé à appeler l'API (protection anti-abus).
# En local : http://localhost:3000 — en prod : https://votre-domaine.vercel.app
ALLOWED_ORIGIN=http://localhost:3000
